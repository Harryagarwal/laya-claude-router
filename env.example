# ── Azure AI Foundry (Option A) ───────────────────────────────────────────────
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
ANTHROPIC_FOUNDRY_API_KEY=your-api-key-here

# ── Anthropic API direct (Option B) ───────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (Option C) ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Laya model path (optional, defaults to ~/laya) ────────────────────────────
# LAYA_PATH=./laya
